---
/** Formação e credenciais (conteúdo real — exibe tudo, sem datas). */
import { credentials } from "../data/site";
---

<section id="formacao" class="scroll-mt-24 py-section">
  <div class="container-site">
    <div class="max-w-reading reveal">
      <p class="eyebrow mb-3">{credentials.eyebrow}</p>
      <h2 class="text-h2">{credentials.title}</h2>
      <p class="mt-4 text-lg text-graphite/80">{credentials.intro}</p>
    </div>

    <!-- Diferenciais em destaque -->
    <ul class="mt-8 flex flex-wrap gap-2.5 reveal">
      {
        credentials.highlights.map((h) => (
          <li class="rounded-full border border-sage/40 bg-sage/10 px-4 py-2 text-sm font-medium text-sage-deep">
            {h}
          </li>
        ))
      }
    </ul>

    <div class="mt-12 grid gap-10 lg:grid-cols-2">
      <!-- Formação acadêmica -->
      <div class="reveal">
        <h3 class="text-h3 font-serif text-forest">Formação acadêmica</h3>
        <ul class="mt-5 space-y-5">
          {
            credentials.education.map((item) => (
              <li class="relative border-l-2 border-sage/40 pl-5">
                <span class="absolute -left-[7px] top-1.5 h-3 w-3 rounded-full bg-sage" aria-hidden="true" />
                <p class="font-semibold text-graphite">{item.institution}</p>
                <p class="mt-1 text-graphite/75">{item.detail}</p>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Cursos e certificações -->
      <div class="reveal">
        <h3 class="text-h3 font-serif text-forest">Cursos e certificações</h3>
        <ul class="mt-5 space-y-5">
          {
            credentials.courses.map((item) => (
              <li class="relative border-l-2 border-stone pl-5">
                <span class="absolute -left-[7px] top-1.5 h-3 w-3 rounded-full bg-terracotta" aria-hidden="true" />
                <p class="font-semibold text-graphite">{item.institution}</p>
                <p class="mt-1 text-graphite/75">{item.detail}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>
